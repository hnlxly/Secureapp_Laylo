name: DevSecOps Pipeline

on:
  push:
    branches: [ "main" ]

jobs:

  scan:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      # SAST - Semgrep
      - name: Run Semgrep
        uses: returntocorp/semgrep-action@v1

      # Dependency scan
      - name: Install pip-audit
        run: pip install pip-audit

      - name: Run pip-audit
        run: pip-audit -r requirements.txt -f json -o pip-audit-report.json

      # Secret scan
      - name: Run Gitleaks
        uses: gitleaks/gitleaks-action@v2

      # Upload scan artifact
      - name: Upload dependency scan report
        uses: actions/upload-artifact@v4
        with:
          name: dependency-scan
          path: pip-audit-report.json

  build:
    runs-on: ubuntu-latest
    needs: scan   # 🚨 CRITICAL REQUIREMENT

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      # Build Docker image
      - name: Build image
        run: |
          docker build -t secure-app:${{ github.sha }} .

      # Container scan (Trivy)
      - name: Run Trivy scan
        uses: aquasecurity/trivy-action@0.20.0
        with:
          image-ref: secure-app:${{ github.sha }}
          format: json
          output: trivy-report.json

      # Generate SBOM (Syft)
      - name: Install Syft
        run: |
          curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh

      - name: Generate SBOM
        run: |
          ./syft secure-app:${{ github.sha }} -o cyclonedx-json > sbom.json

      # Save image metadata
      - name: Save image tag
        run: echo "secure-app:${{ github.sha }}" > image.txt

      # Upload ALL artifacts
      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: build-artifacts
          path: |
            trivy-report.json
            sbom.json
            image.txt
